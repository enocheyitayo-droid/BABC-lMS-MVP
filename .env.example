# Copy to .env.local. Use a Supabase project dedicated to this application.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Only needed for the local bootstrap and database integration-test scripts.
# Never prefix this with NEXT_PUBLIC_. Never deploy it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
BOOTSTRAP_ADMIN_EMAIL=
# Only for first creation by the local operator. At least 12 characters.
BOOTSTRAP_ADMIN_PASSWORD=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local demonstration uses SQLite and fictional records. Disabled in production
# unless explicitly enabled. Use a persistent Node host; SQLite is not for Vercel.
ENABLE_DEMO=
# Later finance and communication phases (not integrated yet).
PAYSTACK_SECRET_KEY=
RESEND_API_KEY=
# BABC local school database. Use a fresh persistent directory for a non-demo school.
# BABC_DB_DIRECTORY=
# Set these privately when running scripts/babc-ict.mjs to provision the first ICT account.
# BABC_ICT_EMAIL=
# BABC_ICT_PASSWORD=
# BABC_ICT_NAME=

# Hosted school portal: set BABC_HOSTED=true on Netlify Functions.
# Netlify Database supplies the durable branch connection automatically.
# BABC_DATABASE_URL= (optional private PostgreSQL connection for other hosts)
